{
  "name": "imba97-blog-vite",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production vite-ssg build && esno ./scripts/copy-fonts.ts && esno ./scripts/rss.ts",
    "generate-rss": "esno scripts/rss.ts",
    "post:new": "esno scripts/create-post.ts",
    "generate-search-index": "esno scripts/search-index-cli.ts",
    "preview": "vite preview",
    "install:stable": "pnpm dlx esno ./scripts/pnpm-stable-install.ts",
    "env:check": "pnpm dlx esno ./scripts/pnpm-env-check.ts",
    "lint": "eslint .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@shikijs/magic-move": "^4.4.3",
    "@unhead/vue": "^3.4.1",
    "@unocss/reset": "^66.10.5",
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "minisearch": "^7.2.0",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "shiki": "^4.4.3",
    "twikoo": "^2.0.9",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-router-better-scroller": "^0.0.0"
  },
  "devDependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@antfu/eslint-config": "^9.5.1",
    "@iconify/json": "^2.2.533",
    "@octokit/rest": "^22.0.1",
    "@shikijs/markdown-it": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@shikijs/twoslash": "^4.4.3",
    "@types/diacritics": "^1.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/node": "^26.6.2",
    "@types/nprogress": "^0.2.3",
    "@unocss/eslint-plugin": "^66.10.5",
    "@unocss/preset-web-fonts": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "diacritics": "^1.3.0",
    "eslint": "^10.11.0",
    "esno": "^4.8.0",
    "feed": "^6.0.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-extra-link": "^0.3.1",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-table-of-contents": "^1.2.0",
    "nano-staged": "^1.0.2",
    "pathe": "^2.0.3",
    "sass-embedded": "^1.105.0",
    "simple-git-hooks": "^2.14.0",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "uno-colors": "^0.1.0",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^32.1.1",
    "vite": "^8.3.1",
    "vite-plugin-inspect": "^12.0.2",
    "vite-plugin-optimize-exclude": "^0.0.1",
    "vite-ssg": "^28.3.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,vue,md,mdx}": "eslint --fix"
  }
}
